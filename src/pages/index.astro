---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { Image } from "astro:assets";
import neonCatalog from "../assets/projects/neon-catalog.png";
import neonCustomizer from "../assets/projects/neon-customizer.png";

const stackGroups = [
  { label: "Backend", technologies: ["Python", "Django", "Flask"] },
  { label: "Frontend", technologies: ["JavaScript", "React", "HTML", "Jinja", "CSS", "Sass"] },
  { label: "Datos", technologies: ["MySQL", "MongoDB"] },
  { label: "Infraestructura y herramientas", technologies: ["Apache", "Git", "Jira"] },
];

---

<BaseLayout>
  <Header />

  <main id="contenido">
    <section id="inicio" class="hero shell" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-copy" data-reveal>
        <div class="eyebrow">
          <span class="status-dot"></span>
          Software Engineer · España
        </div>
        <h1 id="hero-title">Lluc Bosch<br />Ramis<span class="accent">.</span></h1>
        <p>
          Construyo y evoluciono aplicaciones web para el sector hotelero —del backend al frontend— e integro IA en procesos de ingeniería con criterio técnico y control sobre el resultado.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#proyectos">
            Ver proyectos
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
          </a>
          <a class="button button--secondary" href="/cv-lluc-bosch-ramis.pdf" download>
            Descargar CV
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3v9M5.5 8.5 9 12l3.5-3.5M4 15h10"></path></svg>
          </a>
          <a class="button button--secondary" href="mailto:lluc.bosch@gmail.com">
            Contactar
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
          </a>
          <a class="button button--secondary" href="https://www.linkedin.com/in/lluc-bosch-ramis-80959b213/" target="_blank" rel="noopener noreferrer">
            LinkedIn
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 12 12 6M7 6h5v5"></path></svg>
          </a>
        </div>
      </div>

      <aside class="hero-index" aria-label="Áreas de trabajo" data-reveal>
        <div class="hero-index__header">
          <span>Engineering index</span>
          <span>39.57° N / 2.65° E</span>
        </div>
        <ol>
          <li><span>01</span><strong>Hotel products</strong><small>Build · Evolve</small></li>
          <li><span>02</span><strong>Booking engines</strong><small>Web · Data</small></li>
          <li><span>03</span><strong>Integrations</strong><small>Channels · Providers</small></li>
          <li><span>04</span><strong>AI workflows</strong><small>Agents · Tests · Loops</small></li>
        </ol>
        <div class="hero-index__footer">
          <span>Input</span>
          <span class="index-line"></span>
          <span>Verified output</span>
        </div>
      </aside>

      <div class="hero-foot" aria-hidden="true">
        <span>Portfolio / 2026</span>
        <span>Scroll to inspect</span>
      </div>
    </section>

    <section id="perfil" class="section shell" aria-labelledby="profile-title">
      <SectionHeading id="profile-title" index="01" label="Perfil" title="Ingeniería web con contexto de producto y responsabilidad sobre el código." />
      <div class="profile-layout">
        <div class="profile-copy prose" data-reveal>
          <p>
            Soy Software Engineer especializado en desarrollo web. Desde 2022 trabajo en aplicaciones utilizadas en entornos reales, participando tanto en backend como en frontend y en la evolución continua de sistemas existentes.
          </p>
          <p>
            He desarrollado un conocimiento amplio del sector hotelero trabajando en productos para hoteles, motores de reserva e integraciones con canales y proveedores externos como Booking y GIATA. Me interesa entender ese contexto antes de cambiar el código: cómo encaja una pieza, qué puede romperse y cómo comprobar que la solución responde al problema real.
          </p>
        </div>
        <dl class="profile-facts" data-reveal>
          <div><dt>Enfoque</dt><dd>Backend + Frontend</dd></div>
          <div><dt>Entorno</dt><dd>Aplicaciones web en producción</dd></div>
          <div><dt>Sector</dt><dd>Tecnología hotelera</dd></div>
          <div><dt>Base</dt><dd>España</dd></div>
          <div><dt>Idiomas</dt><dd>Castellano · Catalán · Inglés</dd></div>
        </dl>
      </div>
    </section>

    <section id="experiencia" class="section shell" aria-labelledby="experience-title">
      <SectionHeading id="experience-title" index="02" label="Experiencia" title="Trabajo profesional sobre sistemas que deben seguir funcionando." />
      <article class="experience" data-reveal>
        <header class="experience__header">
          <p class="experience__date">07/2022 — Actualidad</p>
          <div>
            <p class="experience__company">Dingus</p>
            <h3>Software Engineer</h3>
          </div>
          <span class="experience__number" aria-hidden="true">01</span>
        </header>
        <div class="experience__body">
          <div class="experience__summary prose">
            <p>
              Desde 2022 desarrollo y evoluciono productos web para el sector hotelero. Trabajo sobre aplicaciones existentes que deben seguir funcionando mientras incorporan nuevas funcionalidades, integraciones y cambios de producto.
            </p>
            <p>
              Mi ámbito abarca servicios backend, interfaces frontend, persistencia de datos y comunicación con sistemas externos. Esto requiere entender el flujo completo antes de modificarlo y comprobar el comportamiento después de cada cambio.
            </p>
            <a class="experience-case-link" href="#caso-integraciones">
              Ver caso de integración
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
            </a>
          </div>
          <ul class="responsibility-list" aria-label="Áreas de contribución profesional">
            <li>
              <span>01</span>
              <div>
                <strong>Evolución de producto</strong>
                <p>Mantenimiento, diagnóstico e implementación de funcionalidades en productos para hoteles y motores de reserva.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <strong>Integraciones externas</strong>
                <p>Implementación de flujos de consulta, transformación y envío de datos entre proveedores como Booking y GIATA.</p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <strong>Entrega full-stack</strong>
                <p>Desarrollo backend con Python, Django y Flask; frontend con React y JavaScript; persistencia con MySQL y MongoDB.</p>
              </div>
            </li>
            <li>
              <span>04</span>
              <div>
                <strong>Desarrollo asistido por IA</strong>
                <p>Uso de agentes, skills y ciclos de revisión para implementar, verificar, revisar seguridad y cubrir el comportamiento con pruebas.</p>
              </div>
            </li>
          </ul>
        </div>
        <footer class="experience__stack">
          <span>Python</span><span>Django</span><span>Flask</span><span>React</span><span>JavaScript</span><span>MySQL</span><span>MongoDB</span><span>Apache</span><span>Git</span><span>Jira</span>
        </footer>
      </article>
    </section>

    <section id="proyectos" class="section shell" aria-labelledby="projects-title">
      <SectionHeading id="projects-title" index="03" label="Proyectos" title="Productos construidos para resolver problemas concretos." />

      <article class="featured-project" data-reveal>
        <header class="featured-project__header">
          <div class="featured-project__meta">
            <span>Proyecto destacado</span>
            <span>01 / Neon Led Spain</span>
          </div>
          <span class="featured-project__status">
            <span aria-hidden="true"></span>
            Demo pública · En evolución
          </span>
        </header>

        <div class="featured-project__intro">
          <div>
            <p class="featured-project__type">E-commerce · Configurador de producto</p>
            <h3>Neon Led Spain</h3>
          </div>
          <p class="featured-project__lead">
            Una tienda online especializada en neones LED personalizados. El producto combina catálogo, configuración visual, precio en vivo, carrito, solicitudes a medida y un panel de gestión.
          </p>
        </div>

        <div id="neon-gallery" class="featured-project__gallery" data-reveal>
          <figure>
            <a href="https://neonledspain.llucbosch.com/productos" target="_blank" rel="noopener noreferrer">
              <Image
                src={neonCatalog}
                alt="Catálogo de Neon Led Spain con filtros por categoría, productos y precios"
                widths={[560, 840, 1120]}
                sizes="(min-width: 768px) 50vw, 100vw"
                format="webp"
                quality={80}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span>01 / Catálogo</span>
              <p>Productos, categorías y precios de partida en una vista filtrable.</p>
            </figcaption>
          </figure>
          <figure>
            <a href="https://neonledspain.llucbosch.com/personalizar" target="_blank" rel="noopener noreferrer">
              <Image
                src={neonCustomizer}
                alt="Configurador de Neon Led Spain con previsualización, opciones y precio estimado"
                widths={[560, 840, 1120]}
                sizes="(min-width: 768px) 50vw, 100vw"
                format="webp"
                quality={80}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span>02 / Configurador</span>
              <p>Preview, tipografía, color y precio estimado dentro del mismo flujo.</p>
            </figcaption>
          </figure>
        </div>

        <div class="featured-project__details">
          <div>
            <span>01 / Problema</span>
            <h4>Comprar un producto que todavía no existe</h4>
            <p>Un neón personalizado no encaja en un catálogo convencional: antes de comprar, el usuario necesita definir texto, estilo y medidas, visualizar el resultado y conocer su precio.</p>
          </div>
          <div>
            <span>02 / Solución</span>
            <h4>Configuración y gestión en un mismo producto</h4>
            <p>El flujo permite personalizar el neón con preview y precio en vivo, añadirlo al carrito o enviar un diseño propio, mientras el área administrativa centraliza productos, precios, pedidos y solicitudes.</p>
          </div>
          <div>
            <span>03 / Decisiones</span>
            <h4>El servidor conserva la fuente de verdad</h4>
            <p>El precio se recalcula en servidor antes de persistir el pedido. Prisma y PostgreSQL estructuran el dominio; Supabase gestiona datos y archivos; Docker y Nginx sostienen el despliegue self-hosted.</p>
          </div>
        </div>

        <div class="featured-project__scope">
          <div>
            <span>Ámbito del trabajo</span>
            <p>Producto · Frontend · Backend · Datos · Despliegue</p>
          </div>
          <div>
            <span>Estado actual</span>
            <p>Demo funcional; pagos y automatización de emails todavía pendientes.</p>
          </div>
        </div>

        <footer class="featured-project__footer">
          <ul aria-label="Tecnologías utilizadas en Neon Led Spain">
            <li>Next.js</li>
            <li>TypeScript</li>
            <li>Prisma</li>
            <li>PostgreSQL</li>
            <li>Supabase</li>
            <li>Docker</li>
          </ul>
          <div class="featured-project__actions">
            <a class="button button--primary" href="https://neonledspain.llucbosch.com/" target="_blank" rel="noopener noreferrer">
              Ver demo
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 12 12 6M7 6h5v5"></path></svg>
            </a>
            <a class="button button--secondary" href="https://github.com/lluc898/neonweb" target="_blank" rel="noopener noreferrer">
              Ver código
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 12 12 6M7 6h5v5"></path></svg>
            </a>
          </div>
        </footer>
      </article>

      <article id="caso-integraciones" class="professional-case" data-reveal>
        <header class="professional-case__header">
          <div class="professional-case__meta">
            <span>Caso profesional anonimizado</span>
            <span>02 / Integración de datos hoteleros</span>
          </div>
          <span>Booking → GIATA</span>
        </header>

        <div class="professional-case__intro">
          <div>
            <p class="professional-case__type">APIs externas · Sincronización de datos</p>
            <h3>Un flujo para conectar dos modelos de datos distintos.</h3>
          </div>
          <p>
            Implementé una integración que consulta la API oficial de Booking desde un sistema externo, transforma los datos recibidos al contrato esperado por GIATA y los envía para completar la sincronización.
          </p>
        </div>

        <ol class="integration-flow" aria-label="Flujo de sincronización entre Booking y GIATA">
          <li>
            <span>01 / Pull</span>
            <h4>Recoger los datos</h4>
            <p>El sistema de origen consulta la API oficial de Booking y obtiene la información que debe sincronizarse.</p>
          </li>
          <li>
            <span>02 / Transform</span>
            <h4>Adaptar el contrato</h4>
            <p>Un transformer dedicado convierte y organiza los datos de Booking según la estructura requerida por GIATA.</p>
          </li>
          <li>
            <span>03 / Push</span>
            <h4>Completar la sincronización</h4>
            <p>El payload transformado se envía a GIATA, cerrando el flujo entre ambos proveedores externos.</p>
          </li>
        </ol>

        <div class="professional-case__evidence">
          <div>
            <span>Mi responsabilidad</span>
            <p>Implementación del recorrido completo de sincronización: consulta, transformación y envío de los datos.</p>
          </div>
          <div>
            <span>Decisión técnica</span>
            <p>Aislar la adaptación en un transformer para separar los contratos de Booking y GIATA del resto del sistema.</p>
          </div>
          <div>
            <span>Resultado</span>
            <p>Un flujo definido de pull, transformación y push para sincronizar información entre los dos proveedores.</p>
          </div>
        </div>

        <footer class="professional-case__footer">
          <ul aria-label="Conceptos aplicados en la integración">
            <li>Integración de APIs</li>
            <li>Data mapping</li>
            <li>Transformers</li>
            <li>Pull / Push</li>
          </ul>
          <p>Se omiten nombres internos, arquitectura y datos operativos por confidencialidad.</p>
        </footer>
      </article>
    </section>

    <section id="stack" class="section shell" aria-labelledby="stack-title">
      <SectionHeading id="stack-title" index="04" label="Stack" title="Tecnologías elegidas y usadas en trabajo real." />
      <div class="stack-grid" data-reveal>
        {stackGroups.map((group, index) => (
          <article class="stack-group">
            <header>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{group.label}</h3>
            </header>
            <ul>
              {group.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="ia" class="section shell" aria-labelledby="ai-title">
      <SectionHeading id="ai-title" index="05" label="AI-assisted development" title="IA integrada en el proceso, no separada de la ingeniería." />
      <div class="ai-layout">
        <aside id="ai-evidence" class="ai-evidence" aria-labelledby="ai-evidence-title" data-reveal>
          <p class="ai-evidence__eyebrow">Evidencia pública</p>
          <h3 id="ai-evidence-title">Controles visibles en este repositorio.</h3>
          <p>El despliegue solo se ejecuta cuando todas las validaciones terminan correctamente.</p>
          <ul class="ai-checks">
            <li><code>astro check</code><span>Astro + TypeScript</span></li>
            <li><code>astro build</code><span>Build de producción</span></li>
            <li><code>check:a11y</code><span>HTML y accesibilidad</span></li>
            <li><code>test:e2e</code><span>Navegación e interfaz</span></li>
            <li><code>check:seo</code><span>Metadatos e indexación</span></li>
            <li><code>check:links</code><span>Enlaces y CTA</span></li>
          </ul>
          <footer class="ai-evidence__footer">
            <span>Claude CLI</span>
            <a href="https://github.com/lluc898/portfolio/blob/main/.github/workflows/ci.yml" target="_blank" rel="noopener noreferrer">
              Ver workflow
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 12 12 6M7 6h5v5"></path></svg>
            </a>
          </footer>
        </aside>
        <div class="ai-content" data-reveal>
          <p class="ai-lead">
            Utilizo Claude CLI desde terminal para acelerar exploración, implementación y debugging. Agentes y skills especializados revisan el resultado desde perspectivas distintas; la decisión final y la responsabilidad sobre cada cambio siguen siendo mías.
          </p>
          <ol class="workflow">
            <li>
              <span class="workflow__index">01 / Contexto</span>
              <h3>Delimitar antes de generar</h3>
              <p>Primero se inspeccionan el código existente, las dependencias y los criterios de aceptación para acotar la tarea.</p>
            </li>
            <li>
              <span class="workflow__index">02 / Implementación</span>
              <h3>Cambiar dentro del sistema</h3>
              <p>Claude CLI ayuda a implementar y depurar manteniendo el cambio alineado con los patrones del proyecto.</p>
            </li>
            <li>
              <span class="workflow__index">03 / Revisión independiente</span>
              <h3>Buscar fallos desde varios ángulos</h3>
              <p>Agentes especializados comprueban la implementación, la seguridad y la cobertura de los comportamientos relevantes.</p>
            </li>
            <li>
              <span class="workflow__index">04 / Cierre humano</span>
              <h3>Verificar, decidir y entregar</h3>
              <p>Los hallazgos vuelven al ciclo; el diff y las validaciones se revisan antes de aceptar y desplegar el resultado.</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact-section" aria-labelledby="contact-title">
      <div class="shell" data-reveal>
        <div class="contact-meta"><span>06</span><span>Contacto</span></div>
        <p class="contact-kicker">¿Hablamos?</p>
        <h2 id="contact-title">Construyamos algo<br />que tenga sentido<span class="accent">.</span></h2>
        <a class="contact-email" href="mailto:lluc.bosch@gmail.com">
          <span>lluc.bosch@gmail.com</span>
          <svg viewBox="0 0 36 36" aria-hidden="true"><path d="M7 18h22M20 9l9 9-9 9"></path></svg>
        </a>
        <div class="contact-links">
          <a href="/cv-lluc-bosch-ramis.pdf" download>Descargar CV <span>↓</span></a>
          <a href="https://www.linkedin.com/in/lluc-bosch-ramis-80959b213/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a>
          <a href="https://github.com/lluc898" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
          <a href="mailto:lluc.bosch@gmail.com">Email <span>↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <div><strong>Lluc Bosch Ramis</strong><span>Software Engineer</span></div>
      <p>© 2026 · Diseñado y desarrollado con atención al detalle.</p>
      <a href="#inicio">Volver arriba <span>↑</span></a>
    </div>
  </footer>
</BaseLayout>
