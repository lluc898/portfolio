---
interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
}

const { id, index, label, title } = Astro.props;
---

<div class="section-heading" data-reveal>
  <div class="section-heading__meta">
    <span>{index}</span>
    <span>{label}</span>
  </div>
  <h2 id={id}>{title}</h2>
</div>
